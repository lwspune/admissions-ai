{
  "name": "admissions-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "node scripts/build-check.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "items:lint": "node scripts/items-lint.mjs",
    "db:verify": "node scripts/verify-schema.mjs",
    "db:verify-rls": "tsx scripts/verify-rls.mts",
    "items:seed": "node scripts/seed-items.mjs",
    "staff:add": "node scripts/create-staff.mjs add",
    "staff:list": "node scripts/create-staff.mjs list",
    "issue": "tsx scripts/issue-test.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vercel": "^59.25.0",
    "vitest": "^2.1.0"
  }
}
