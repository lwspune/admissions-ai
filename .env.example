# Supabase — per environment. Previews MUST point at the staging project (spec 11).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the candidate link staff copy into WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Guards the scheduled routes: the purge, and the hourly GoPost read.
CRON_SECRET=

# GoPost's admissions feed (its ADMISSIONS_LEADS_SECRET). Read by /api/cron/gopost
# and `npm run leads:gopost`.
GOPOST_LEADS_SECRET=

# PYQ Vault's public API, read by `npm run hiring:import` only (never the app).
# Its public URL and anon key, the same values pyqvault.com ships to browsers.
PYQVAULT_URL=
PYQVAULT_ANON_KEY=
